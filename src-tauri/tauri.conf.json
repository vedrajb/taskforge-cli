{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiveMind",
  "version": "0.1.0",
  "identifier": "dev.taskforge.app",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "beforeBuildCommand": "npm run desktop:web:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HiveMind",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
