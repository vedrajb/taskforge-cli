{
  "name": "taskforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tfg": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts --tui",
    "desktop:dev": "npm run build && tauri dev",
    "desktop:build": "npm run build && tauri build --no-bundle",
    "desktop:build:installer": "npm run build && tauri build",
    "desktop:web:dev": "vite --config desktop/vite.config.ts --host 127.0.0.1",
    "desktop:web:build": "vite build --config desktop/vite.config.ts",
    "test": "node --test --import tsx tests/agents.test.ts"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "acpx": "^0.7.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
